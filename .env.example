# Copy to .env and adjust for your environment.
# The local defaults below match docker-compose.yml.

# Database / cache / broker (host-side scripts use localhost)
DATABASE_URL=postgresql://anomaly:anomaly_pw@localhost:5432/anomaly_detection
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# MLflow: sqlite:///mlflow.db locally, http://localhost:5000 with compose
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Copilot: ollama (default), openai, or none for deterministic demo answers
COPILOT_PROVIDER=none
# local uvicorn: http://localhost:11434
# docker compose: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: only needed for okta_puller.py
OKTA_ORG_URL=
OKTA_API_TOKEN=

# Optional: set when the dashboard talks to a non-proxied API
# VITE_API_URL=http://localhost:8000
